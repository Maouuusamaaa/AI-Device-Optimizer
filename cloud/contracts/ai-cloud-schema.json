{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-device-optimizer/ai-cloud-schema-v1.json",
  "title": "AI Device Optimizer Cloud Foundation Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "observation",
    "recommendation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "observation": {
      "type": "object",
      "required": [
        "observationId",
        "capturedAt",
        "device",
        "telemetry"
      ],
      "properties": {
        "observationId": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "object",
          "required": [
            "apiLevel",
            "architecture"
          ],
          "properties": {
            "apiLevel": {
              "type": "integer",
              "minimum": 21
            },
            "architecture": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "required": [
            "batteryPercent",
            "temperatureC",
            "availableRamMb"
          ],
          "properties": {
            "batteryPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "temperatureC": {
              "type": "number"
            },
            "availableRamMb": {
              "type": "number",
              "minimum": 0
            },
            "cpuPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "storageFreeMb": {
              "type": "number",
              "minimum": 0
            },
            "networkConnected": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "required": [
        "recommendationId",
        "mode",
        "diagnosis",
        "confidence",
        "evidenceRefs",
        "candidateAction",
        "execution"
      ],
      "properties": {
        "recommendationId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "ADVISORY_ONLY"
        },
        "diagnosis": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidateAction": {
          "type": "object",
          "required": [
            "actionId",
            "reason",
            "reversible",
            "risk"
          ],
          "properties": {
            "actionId": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "reversible": {
              "type": "boolean"
            },
            "risk": {
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "NONE"
              ]
            }
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "required": [
            "requested",
            "deviceMutationAllowed"
          ],
          "properties": {
            "requested": {
              "const": false
            },
            "deviceMutationAllowed": {
              "const": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
