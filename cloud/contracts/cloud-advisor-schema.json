{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-device-optimizer/cloud-advisor-schema-v1.json",
  "title": "AI Device Optimizer Cloud Advisor Candidate Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "advisorVersion", "evidenceId", "recommendations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "advisorVersion": { "type": "string", "minLength": 1 },
    "evidenceId": { "type": "string", "minLength": 1 },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policyId", "actionType", "parameters", "reason", "expectedEffect"],
        "properties": {
          "policyId": { "type": "string", "minLength": 1 },
          "actionType": { "type": "string", "minLength": 1 },
          "parameters": { "type": "object", "additionalProperties": true },
          "reason": { "type": "string", "minLength": 1 },
          "expectedEffect": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}